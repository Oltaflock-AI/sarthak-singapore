# Environment variables for the Next.js app (Vercel). Copy to .env for local dev.
# These must ALSO be set in the Vercel project for production.
# (Supabase Edge Functions — elevenlabs-webhook / vobiz-webhook — have their own
#  separate secrets: ELEVENLABS_WEBHOOK_SECRET, VOBIZ_AUTH_TOKEN, etc.)

# --- Supabase (server-side only) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- ElevenLabs (outbound calls) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- OpenAI (lead enrichment, gpt-4.1-mini) ---
OPENAI_API_KEY=

# --- Dashboard auth / display ---
DASHBOARD_PASSWORD=              # gates the whole app; unset = gate disabled
NEXT_PUBLIC_DASHBOARD_SINCE=     # ISO date; hide data before this (optional)

# --- Dialer cron ---
# Must match the CRON_SECRET GitHub Actions secret (.github/workflows/dialer-tick.yml).
# The proxy lets /api/voice/process through only on `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- Zoho CRM (India data center) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=              # permanent; obtained once from the grant code
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.in
ZOHO_API_DOMAIN=www.zohoapis.in
